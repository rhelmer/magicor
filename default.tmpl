    <script type="application/javascript">

    const GAME_AR = 800 / 600

    function is_portrait_phone() {
        return window.matchMedia("(max-width: 900px) and (orientation: portrait)").matches
    }

    function is_touch_phone() {
        return window.matchMedia("(max-width: 900px) and (pointer: coarse)").matches
            || (navigator.maxTouchPoints > 0 && window.innerWidth < 900)
    }

    function is_standalone_pwa() {
        return window.matchMedia("(display-mode: standalone)").matches
            || window.navigator.standalone === true
    }

    function is_ios_browser() {
        return /iPhone|iPad|iPod/i.test(navigator.userAgent) && !is_standalone_pwa()
    }

    function a2hs_hint_dismissed() {
        try {
            return localStorage.getItem("magicor-a2hs-dismissed") === "1"
        } catch (_) {
            return false
        }
    }

    function dismiss_a2hs_hint() {
        try {
            localStorage.setItem("magicor-a2hs-dismissed", "1")
        } catch (_) {}
        update_a2hs_hint()
    }

    function a2hs_instructions() {
        if (is_ios_browser()) {
            return "Tap Share, then Add to Home Screen. Open Magicor from your home screen for fullscreen landscape play."
        }
        return "Use your browser menu to install or add this page to your home screen for fullscreen play."
    }

    function update_a2hs_hint() {
        const hint = document.getElementById("a2hs-hint")
        const text = document.getElementById("a2hs-hint-text")
        if (!hint) return
        if (text) text.textContent = a2hs_instructions()
        const show = document.documentElement.classList.contains("game-ready")
            && is_touch_phone()
            && !is_standalone_pwa()
            && !a2hs_hint_dismissed()
        hint.hidden = !show
    }

    function schedule_a2hs_hint() {
        if (globalThis.__magicor_a2hs_scheduled) return
        globalThis.__magicor_a2hs_scheduled = true
        setTimeout(update_a2hs_hint, 2500)
    }

    function is_fullscreen() {
        return !!(document.fullscreenElement || document.webkitFullscreenElement)
    }

    function immersive_hint_dismissed() {
        try {
            return sessionStorage.getItem("magicor-immersive-hint") === "1"
        } catch (_) {
            return false
        }
    }

    function dismiss_immersive_hint() {
        try {
            sessionStorage.setItem("magicor-immersive-hint", "1")
        } catch (_) {}
        update_immersive_hint()
    }

    function update_immersive_hint() {
        const hint = document.getElementById("immersive-hint")
        if (!hint) return
        const show = document.documentElement.classList.contains("game-ready")
            && is_touch_phone()
            && !is_portrait_phone()
            && !is_standalone_pwa()
            && !is_fullscreen()
            && !immersive_hint_dismissed()
        hint.hidden = !show
    }

    function sync_stage_to_viewport() {
        const stage = document.getElementById("game-stage")
        const vv = window.visualViewport
        if (!stage) return
        if (vv) {
            stage.style.position = "fixed"
            stage.style.top = vv.offsetTop + "px"
            stage.style.left = vv.offsetLeft + "px"
            stage.style.width = vv.width + "px"
            stage.style.height = vv.height + "px"
            stage.style.right = "auto"
            stage.style.bottom = "auto"
            stage.style.padding = "0"
        }
    }

    function viewport_size() {
        const vv = window.visualViewport
        return {
            w: vv ? vv.width : window.innerWidth,
            h: vv ? vv.height : window.innerHeight,
        }
    }

    function fit_game_canvas() {
        const canvas = document.getElementById("canvas")
        const stage = document.getElementById("game-stage")
        if (!canvas || !stage) return

        document.documentElement.classList.add("game-ready")
        sync_stage_to_viewport()
        const { w: maxW, h: maxH } = viewport_size()

        let wantW = maxW
        let wantH = Math.trunc(wantW / GAME_AR)
        if (wantH > maxH) {
            wantH = maxH
            wantW = Math.trunc(wantH * GAME_AR)
        }

        canvas.style.width = wantW + "px"
        canvas.style.height = wantH + "px"
        schedule_a2hs_hint()
        update_immersive_hint()
    }

    async function try_enter_fullscreen() {
        if (is_standalone_pwa() || is_fullscreen()) return
        const el = document.getElementById("game-stage") || document.documentElement
        try {
            if (el.requestFullscreen) {
                await el.requestFullscreen({ navigationUI: "hide" })
            } else if (el.webkitRequestFullscreen) {
                await el.webkitRequestFullscreen()
            }
        } catch (_) {
            // Safari tabs may refuse; visualViewport sizing still helps.
        }
        setTimeout(fit_game_canvas, 100)
    }

    async function try_lock_landscape() {
        if (!is_standalone_pwa()) return
        try {
            if (screen.orientation && screen.orientation.lock) {
                await screen.orientation.lock("landscape")
                fit_game_canvas()
            }
        } catch (_) {}
    }

    function magicor_client_to_game(clientX, clientY) {
        const canvas = document.getElementById("canvas")
        if (!canvas) return null
        const rect = canvas.getBoundingClientRect()
        if (!rect.width || !rect.height) return null
        return {
            x: (clientX - rect.left) / rect.width * 800,
            y: (clientY - rect.top) / rect.height * 600,
        }
    }

    function magicor_norm_to_game(nx, ny) {
        const vv = window.visualViewport
        const vw = vv ? vv.width : window.innerWidth
        const vh = vv ? vv.height : window.innerHeight
        const left = vv ? vv.offsetLeft : 0
        const top = vv ? vv.offsetTop : 0
        return magicor_client_to_game(left + nx * vw, top + ny * vh)
    }

    globalThis.magicor_client_to_game = magicor_client_to_game
    globalThis.magicor_norm_to_game = magicor_norm_to_game

    function install_pointer_bridge() {
        const canvas = document.getElementById("canvas")
        if (!canvas || globalThis.__magicorPointerBridge) return
        globalThis.__magicorPointerBridge = true
        const update_client = (clientX, clientY) => {
            const pos = magicor_client_to_game(clientX, clientY)
            if (pos) globalThis.__magicorPointer = pos
        }
        const update = (e) => update_client(e.clientX, e.clientY)
        const update_touch = (e) => {
            const t = e.changedTouches?.[0] || e.touches?.[0]
            if (t) update_client(t.clientX, t.clientY)
        }
        const clear = () => {
            globalThis.__magicorPointer = null
        }
        canvas.addEventListener("pointerdown", update, { passive: true })
        canvas.addEventListener("pointermove", update, { passive: true })
        canvas.addEventListener("pointerup", clear, { passive: true })
        canvas.addEventListener("pointercancel", clear, { passive: true })
        canvas.addEventListener("touchstart", update_touch, { passive: true })
        canvas.addEventListener("touchmove", update_touch, { passive: true })
        canvas.addEventListener("touchend", clear, { passive: true })
        canvas.addEventListener("touchcancel", clear, { passive: true })
    }

    function install_mobile_viewport() {
        install_pointer_bridge()
        globalThis.window_resize = function(gui_divider) {
            fit_game_canvas()
            setTimeout(() => window.focus?.(), 100)
        }
        if (!globalThis.__magicor_viewport_installed) {
            globalThis.__magicor_viewport_installed = true
            const a2hsDismiss = document.getElementById("a2hs-hint-dismiss")
            const a2hsLater = document.getElementById("a2hs-hint-later")
            if (a2hsDismiss) a2hsDismiss.addEventListener("click", dismiss_a2hs_hint)
            if (a2hsLater) a2hsLater.addEventListener("click", dismiss_a2hs_hint)
            const immersiveBtn = document.getElementById("immersive-hint-action")
            if (immersiveBtn) {
                immersiveBtn.addEventListener("click", async () => {
                    await try_enter_fullscreen()
                    dismiss_immersive_hint()
                })
            }
            document.addEventListener("fullscreenchange", () => setTimeout(fit_game_canvas, 50))
            document.addEventListener("webkitfullscreenchange", () => setTimeout(fit_game_canvas, 50))
            window.addEventListener("resize", () => setTimeout(fit_game_canvas, 50))
            window.addEventListener("orientationchange", () => setTimeout(fit_game_canvas, 200))
            if (window.visualViewport) {
                window.visualViewport.addEventListener("resize", () => setTimeout(fit_game_canvas, 50))
                window.visualViewport.addEventListener("scroll", () => {
                    window.scrollTo(0, 0)
                    setTimeout(fit_game_canvas, 50)
                })
            }
            window.scrollTo(0, 0)
            document.addEventListener("touchmove", (e) => {
                if (e.target === document.documentElement || e.target === document.body) {
                    e.preventDefault()
                }
            }, { passive: false })
            const canvas = document.getElementById("canvas")
            if (canvas) {
                canvas.addEventListener("pointerdown", () => {
                    try_enter_fullscreen()
                    try_lock_landscape()
                }, { once: true })
            }
        }
        fit_game_canvas()
    }

    function hide_splash() {
        const el = document.getElementById("transfer")
        if (!el || el.dataset.dismissed === "1") return
        el.dataset.dismissed = "1"
        el.hidden = true
        el.classList.add("is-hidden")
        el.style.display = "none"
        el.style.visibility = "hidden"
        el.style.pointerEvents = "none"
        el.replaceChildren()
        document.documentElement.classList.add("game-ready")
        document.body.style.background = "#000000"
        const canvas = document.getElementById("canvas")
        if (canvas) {
            canvas.style.visibility = "visible"
        }
    }

    globalThis.__canvas_resized = (self, ecw, ech) => {
        if (document.getElementById("transfer")?.dataset.dismissed === "1") {
            fit_game_canvas()
        }
    }

    async function custom_onload(debug_hidden) {
        if (window.location.hash === "#debug") {
            debug_hidden = false
        }
        console.log(__FILE__, "custom_onload")

        const pyconsoleEl = document.getElementById("pyconsole")
        const terminalEl = document.getElementById("terminal")
        if (pyconsoleEl) pyconsoleEl.hidden = debug_hidden
        if (terminalEl) terminalEl.hidden = debug_hidden
        if (window.system) system.hidden = debug_hidden
        if (window.info) info.hidden = debug_hidden
        if (window.box) box.hidden = debug_hidden
        if (window.python && python.config) python.config.debug = !debug_hidden

        if (window.location.hash !== "#debug") {
            infobox.hidden = true
            infobox.style.display = "none"
        } else if (window.transfer) {
            transfer.hidden = debug_hidden
        }
    }

    function custom_prerun(){
        // no python main and no (MEMFS + VFS) yet.
        console.log(__FILE__, "custom_prerun")

    }

    function custom_postrun(){
        // python main and no VFS filesystem yet.
        console.log(__FILE__, "custom_postrun")
    }

    function debug() {
        // allow to gain access to dev tools from js console
        // but only on desktop. difficult to reach when in iframe
        python.config.debug = true
        custom_onload(false)
        Module.PyRun_SimpleString("shell.uptime()")
        window_resize()
    }

    function info_inline(data){
        document.getElementById("info").innerHTML = data
    }

    function info_online(url) {
        // display info about current APK
        fetch( url /*, options */)
            .then((response) => response.text())
            .then((html) => {
                info_inline(html);
        })
        .catch((error) => {
            console.warn(error);
        });
    }

    function frame_online(url) {
        window.frames["iframe"].location = url;
    }

    </script>

</body>
